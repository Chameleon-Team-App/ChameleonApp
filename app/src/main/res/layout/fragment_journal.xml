<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#292929"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Entry -->
            <EditText
                android:id="@+id/titleEntryBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter title here"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Mood Emoji Selection -->
            <TextView
                android:id="@+id/moodPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select your mood"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <!-- Mood Buttons -->
                <Button
                    android:id="@+id/button_happy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😊"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/button_sad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😢"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/button_angry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😡"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/button_anxious"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😟"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/button_neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😐"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Journal Text -->
            <EditText
                android:id="@+id/journalEntryText"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:hint="Enter your journal entry..."
                android:textColor="#000000"
                android:textSize="16sp"
                android:gravity="top"
                android:layout_marginBottom="8dp" />

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/imageViewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Image Selection Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/uploadFromGalleryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gallery" />

                <Button
                    android:id="@+id/openCameraButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera" />
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/saveJournalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save" />
        </LinearLayout>
    </ScrollView>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/userNotesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:clipToPadding="false" />

</LinearLayout>
