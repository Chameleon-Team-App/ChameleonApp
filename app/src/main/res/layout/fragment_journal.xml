<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background3"
    tools:context=".ui.journal.JournalFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How are you feeling today?"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingBottom="90dp" />

        <!-- Title Entry -->
        <EditText
            android:id="@+id/titleEntryBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter title here"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Mood Selection -->
        <TextView
            android:id="@+id/moodPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your mood:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <!-- Mood Buttons -->
            <Button
                android:id="@+id/buttonHappy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😊"
                android:textSize="24sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😢"
                android:textSize="24sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonAngry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😡"
                android:textSize="24sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonAnxious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😟"
                android:textSize="24sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonNeutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😐"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Journal Text -->
        <EditText
            android:id="@+id/journalEntryText"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:hint="Write your journal entry here..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/imageViewPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Image Selection Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/openCameraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Camera"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/uploadFromGalleryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#8BC34A"
            android:padding="18dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back button -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#8BC34A"
            android:padding="18dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </LinearLayout>
</ScrollView>
