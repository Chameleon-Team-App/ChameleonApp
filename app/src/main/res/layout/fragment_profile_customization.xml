<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:padding="16dp">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ic_rounded_corner"
        android:contentDescription="Back Button"
        android:src="@drawable/ic_back_arrow"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:onClick="navigateBack"
        app:tint="@color/white" />

    <!-- Container for profile customization form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.888">

        <!-- Container for profile picture and edit icon -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Profile picture button -->
            <ImageButton
                android:id="@+id/change_picture_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="Profile Picture"
                android:scaleType="centerCrop"
                android:src="@drawable/default_profile" />

            <!-- Edit icon overlay -->
            <ImageView
                android:id="@+id/edit_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/ic_edit_icon" />

        </FrameLayout>

        <!-- Username EditText with edit icon -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/change_picture_button">

            <EditText
                android:id="@+id/username_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_rounded_corner"
                android:hint="This should not be seen by user"
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:paddingEnd="50dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/edit_icon_username"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/ic_edit_icon" />
        </FrameLayout>

        <!-- First Name EditText with edit icon -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/username_edit_text">

            <EditText
                android:id="@+id/fname_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_rounded_corner"
                android:hint="Enter First Name"
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:paddingEnd="50dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/edit_icon_fname"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/ic_edit_icon" />
        </FrameLayout>

        <!-- Last Name EditText with edit icon -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fname_edit_text">

            <EditText
                android:id="@+id/lname_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_rounded_corner"
                android:hint="Enter Last Name"
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:paddingEnd="50dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/edit_icon_lname"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/ic_edit_icon" />
        </FrameLayout>

        <!-- Bio EditText with edit icon -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lname_edit_text">

            <EditText
                android:id="@+id/bio_edit_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="autofill.HINT_PERSONAL_NOTES"
                android:background="@drawable/ic_rounded_corner"
                android:gravity="top|start"
                android:hint="@string/user_bio"
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/edit_icon_bio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/ic_edit_icon" />
        </FrameLayout>

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ic_rounded_corner"
            android:backgroundTint="@color/white"
            android:text="@string/save_button"
            android:textColor="#3B84F1"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>