<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#292929">

    <TextView
        android:id="@+id/mood_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please select your current mood"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="411dp"
        android:layout_height="96dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_happy"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:onClick="onMoodSelected"
            android:text="😊"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button_sad"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:onClick="onMoodSelected"
            android:text="😢"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button_angry"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:onClick="onMoodSelected"
            android:text="😡"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button_anxious"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:onClick="onMoodSelected"
            android:text="😟"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button_neutral"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:onClick="onMoodSelected"
            android:text="😐"
            android:textSize="30sp" />

    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="back"
        android:textSize="16sp" />
</LinearLayout>
