<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="vertical">

        <!-- Header: Username and Profile Image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/default_profile"
                android:scaleType="centerCrop"
                android:layout_marginEnd="8dp"
                /> <!-- Optional: Circular background -->

            <TextView
                android:id="@+id/usernameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Label for Journal or Mood -->
            <TextView
                android:id="@+id/moodTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_gravity="end"
            android:layout_weight="1"
            android:gravity="end" />


        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <!-- Image -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

        <!-- Entry Text -->
        <TextView
            android:id="@+id/entryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entry text goes here..."
            android:layout_marginTop="8dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/createdDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date: MM/dd/yyyy"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:textSize="14sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
