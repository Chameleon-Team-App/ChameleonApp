<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#292929"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- SwipeRefreshLayout for pull-to-refresh functionality -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Section -->
                <RelativeLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="20dp"
                    android:background="#4CAF50">

                    <!-- Weekly Calendar RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/weeklyCalendarRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />

                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/default_profile"
                        android:layout_centerVertical="true"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="20sp"
                        android:layout_toRightOf="@id/profile_image"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp" />

                    <TextView
                        android:id="@+id/fullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/user_name"
                        android:layout_marginStart="20dp"
                        android:layout_toEndOf="@id/profile_image"
                        android:text="Full Name"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/streakTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="16dp"
                        android:text="Streak: 0"
                        android:textColor="#FF0000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Card Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:orientation="vertical">

                    <!-- Journal Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/JournalButton"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardBackgroundColor="#8BC34A"
                        app:cardElevation="10dp"
                        android:layout_margin="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="5dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_centerHorizontal="true"
                                android:src="@drawable/journal_64dp"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/journalEntryText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Journal"
                                android:layout_centerInParent="true"
                                android:textSize="20sp" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Most Recent Journal Section -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/recentJournalCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        app:cardElevation="5dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:orientation="vertical">

                            <!-- Header: Profile Picture and Username -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <!-- Profile Picture -->
                                <ImageView
                                    android:id="@+id/profileImageView"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/default_profile"
                                    android:scaleType="centerCrop"
                                    android:layout_marginEnd="8dp" />

                                <!-- Username -->
                                <TextView
                                    android:id="@+id/recentJournalUsername"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Username"
                                    android:textStyle="bold"
                                    android:textSize="16sp" />

                                <!-- Mood Emoji -->
                                <TextView
                                    android:id="@+id/recentJournalMood"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="😊"
                                    android:textSize="24sp"
                                    android:layout_gravity="end"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:layout_marginStart="8dp" />
                            </LinearLayout>

                            <!-- Title -->
                            <TextView
                                android:id="@+id/recentJournalTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Title"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:layout_marginTop="8dp" />

                            <!-- Photo (if applicable) -->
                            <ImageView
                                android:id="@+id/recentJournalImage"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:adjustViewBounds="true"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:layout_marginTop="8dp" />

                            <!-- Entry Text -->
                            <TextView
                                android:id="@+id/recentJournalText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Entry text goes here..."
                                android:layout_marginTop="8dp"
                                android:textSize="16sp" />

                            <!-- Created Date -->
                            <TextView
                                android:id="@+id/recentJournalDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date: MM/dd/yyyy"
                                android:layout_gravity="end"
                                android:layout_marginTop="8dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Mental Health Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/MentalHealthButton"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardBackgroundColor="#8BC34A"
                        app:cardElevation="10dp"
                        android:layout_margin="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="5dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_centerHorizontal="true"
                                android:src="@drawable/ic_mental_health_black_24dp"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/mentalHealthText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mental Health"
                                android:layout_centerInParent="true"
                                android:textSize="20sp" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Removed or commented out the feed RecyclerView -->
                <!-- <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="100dp" /> -->
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
