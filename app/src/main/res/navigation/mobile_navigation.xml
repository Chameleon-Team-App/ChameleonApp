<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/navigation_dashboard">

    <!-- Dashboard Fragment -->
    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.mainchameleon.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">

        <!-- Navigate to Journal -->
        <action
            android:id="@+id/action_navigation_dashboard_to_navigation_journal"
            app:destination="@id/navigation_journal" />

        <!-- Navigate to Profile -->
        <action
            android:id="@+id/action_navigation_dashboard_to_navigation_profile"
            app:destination="@id/navigation_profile" />

        <!-- Navigate to Calendar -->
        <action
            android:id="@+id/action_navigation_dashboard_to_navigation_calendar"
            app:destination="@id/navigation_calendar" />

        <!-- Navigate to Mental Health -->
        <action
            android:id="@+id/action_navigation_dashboard_to_navigation_mental_health"
            app:destination="@id/navigation_mental_health" />
    </fragment>

    <!-- Journal Fragment -->
    <fragment
        android:id="@+id/navigation_journal"
        android:name="com.example.mainchameleon.ui.journal.JournalFragment"
        android:label="@string/title_journal"
        tools:layout="@layout/fragment_journal">

        <!-- Navigate Back to Dashboard -->
        <action
            android:id="@+id/action_navigation_journal_to_navigation_dashboard"
            app:destination="@id/navigation_dashboard" />

        <!-- Navigate to Camera -->
        <action
            android:id="@+id/action_navigation_journal_to_navigation_camera"
            app:destination="@id/navigation_camera" />
    </fragment>

    <!-- Profile Fragment -->
    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.mainchameleon.ui.userProfile.UserProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_user_profile">

        <!-- Navigate to Profile Customization -->
        <action
            android:id="@+id/action_navigation_profile_to_navigation_profile_customization"
            app:destination="@id/navigation_profile_customization" />

        <!-- Navigate Back to Dashboard -->
        <action
            android:id="@+id/action_navigation_profile_to_navigation_dashboard"
            app:destination="@id/navigation_dashboard" />

        <!-- Navigate to Friends List -->
        <action
            android:id="@+id/action_navigation_profile_to_navigation_friends_list"
            app:destination="@id/navigation_friends_list" />
    </fragment>

    <!-- Profile Customization Fragment -->
    <fragment
        android:id="@+id/navigation_profile_customization"
        android:name="com.example.mainchameleon.ui.userProfile.ProfileCustomizationFragment"
        android:label="Profile Customization"
        tools:layout="@layout/fragment_profile_customization" />

    <!-- Friends List Fragment -->
    <fragment
        android:id="@+id/navigation_friends_list"
        android:name="com.example.mainchameleon.ui.userProfile.FriendsListFragment"
        android:label="Friends List"
        tools:layout="@layout/fragment_friends_lists">

        <!-- Navigate to Friend Profile -->
        <action
            android:id="@+id/action_friends_list_to_friend_profile"
            app:destination="@id/navigation_friend_profile">
            <argument
                android:name="friendId"
                app:argType="string" />
        </action>

        <!-- Navigate to Feed -->
        <action
            android:id="@+id/action_friends_list_to_navigation_feed_fragment"
            app:destination="@id/navigation_feed_fragment" />
    </fragment>

    <!-- Friend Profile Fragment -->
    <fragment
        android:id="@+id/navigation_friend_profile"
        android:name="com.example.mainchameleon.ui.userProfile.FriendProfileFragment"
        android:label="Friend Profile"
        tools:layout="@layout/fragment_friend_profile" />

    <!-- Feed Fragment -->
    <fragment
        android:id="@+id/navigation_feed_fragment"
        android:name="com.example.mainchameleon.ui.feed.FeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_feed" />

    <!-- Camera Fragment -->
    <fragment
        android:id="@+id/navigation_camera"
        android:name="com.example.mainchameleon.ui.camera.CameraFragment"
        android:label="@string/title_camera"
        tools:layout="@layout/fragment_camera" />

    <!-- Calendar Fragment -->
    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.example.mainchameleon.ui.calendar.CalendarFragment"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar" />

    <!-- Mental Health Fragment -->
    <fragment
        android:id="@+id/navigation_mental_health"
        android:name="com.example.mainchameleon.ui.mentalhealth.MentalHealthFragment"
        android:label="Mental Health"
        tools:layout="@layout/fragment_mental_health" />

</navigation>
