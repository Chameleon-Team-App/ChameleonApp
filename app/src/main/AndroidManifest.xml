<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.mainchameleon"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Feature and Permission Declarations -->
    <!-- Specify that the app uses any camera (front or back) -->
    <uses-feature android:name="android.hardware.camera.any" />

    <!-- Request camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- If you are recording audio with the camera, request this permission too -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permissions for reading and writing to external storage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FirebaseInit"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_chameleon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_chameleon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MainChameleon"
        tools:targetApi="31">

        <!-- Launcher Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration Screen Activity -->
        <activity
            android:name=".ui.loginScreen.RegisterScreen"
            android:exported="true" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Camera Activity (Added) -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="true" />

        <!-- Add any other activities here, ensuring they are declared properly -->

    </application>

</manifest>
